<!-- Built 2026-10-01 from the ECU's own map-descriptor table -->
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <description>Suzuki Hayabusa Gen 3 (RH850/E1L) - full 2 MB reads, software 5JCZSJ40 (ECM 32990-10L4) and 5JCZSJ10 (ECM 32990-10L1). Both files share the identical calibration layout, so this one XDF works for both. Every map/curve comes from the ECU's map-descriptor table (type word + pointers to X axis / Y axis / data), so dimensions and per-table axes are the ECU's own. Names from the DanCycles (MIT) / annotated XDF were carried over where the data matched 100%. Everything else is named by descriptor ID and cluster and needs confirmation before tuning. Unit conversions marked est./unverified are best guesses. Checksums are NOT handled by this XDF.</description>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="1" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x200000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="2 MB full read" />
    <CATEGORY index="0x0" name="xdf moto bin files" />
