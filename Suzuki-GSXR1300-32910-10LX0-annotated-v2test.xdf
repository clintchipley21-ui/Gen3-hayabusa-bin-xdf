  <XDFTABLE uniqueid="0x45F" flags="0x0">
    <title>TPS - Neutral/Clutch-In | Cyl 1</title>
    <description>Fuel table (injector pulse width) for cylinder 1, indexed by throttle position (% TPS) and engine RPM. Used only while the transmission is in neutral or the clutch lever is pulled in, so the bike is not under load in gear -- this is what governs fueling during idle throttle blips, warm-up revs, and stationary throttle response.</description>
    <CATEGORYMEM index="0" category="2" />
    <CATEGORYMEM index="1" category="3" />
    <CATEGORYMEM index="2" category="6" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x183A6C" mmedelementsizebits="16" mmedcolcount="26" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>% TPS</units>
      <indexcount>26</indexcount>
      <decimalpl>1</decimalpl>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X/5">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x172DC4" mmedelementsizebits="16" mmedcolcount="50" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>50</indexcount>
      <decimalpl>0</decimalpl>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="x/2.56">
        <VAR id="x" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x17EC60" mmedelementsizebits="16" mmedrowcount="50" mmedcolcount="26" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <decimalpl>0</decimalpl>
      <min>0.000000</min>
      <max>100.000000</max>
      <outputtype>1</outputtype>
      <MATH equation="x">
