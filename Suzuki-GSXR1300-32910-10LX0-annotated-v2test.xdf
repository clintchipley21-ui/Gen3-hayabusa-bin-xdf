  <XDFTABLE uniqueid="0x0" flags="0x0">
    <title>IGN :: Advance Timing - Cyl 1</title>
    <description>Ignition timing advance table (degrees BTDC) for cylinder 1, indexed by throttle position and RPM. Controls when the spark fires relative to piston position -- more advance generally means more power but more knock risk; this is one of the highest-impact and highest-risk tables to modify.</description>
    <CATEGORYMEM index="0" category="12" />
    <CATEGORYMEM index="1" category="13" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x157A00" mmedelementsizebits="16" mmedcolcount="23" mmedmajorstridebits="0" mmedminorstridebits="0" />
