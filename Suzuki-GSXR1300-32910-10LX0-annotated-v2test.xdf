  <XDFTABLE uniqueid="0x6CA" flags="0x0">
    <title>IGN :: Volt-Dwell - 1</title>
    <description>Ignition coil dwell table -- how long current is allowed to build in the ignition coil primary winding before the spark fires, typically indexed by battery/system voltage and RPM. Governs spark energy; too short = weak spark and misfire risk, too long = coil overheating. Table #1 and #2 likely cover the two coil banks or two dwell stages.</description>
    <CATEGORYMEM index="0" category="12" />
    <CATEGORYMEM index="1" category="15" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x157A30" mmedelementsizebits="16" mmedcolcount="9" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>% TPS</units>
      <indexcount>9</indexcount>
      <decimalpl>1</decimalpl>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X*0.0390625 + 6.7">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x182A1C" mmedelementsizebits="16" mmedcolcount="20" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>20</indexcount>
      <decimalpl>0</decimalpl>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="x/2.56">
